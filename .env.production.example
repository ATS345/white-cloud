# 生产环境配置模板
# 复制此文件为 .env.production 并修改相应配置

# ============================================
# 核心配置 (必须修改)
# ============================================

# JWT密钥 - 必须使用强密钥 (建议32+字符，包含大小写字母、数字、特殊符号)
# 生成方式: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE_CHANGE_THIS
JWT_REFRESH_SECRET=YOUR_SECURE_REFRESH_SECRET_HERE_CHANGE_THIS
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# 数据库配置
# ============================================

# SQLite (默认)
DATABASE_URL=file:./data/prod.db

# PostgreSQL (生产推荐)
# DATABASE_URL=postgresql://user:password@localhost:5432/yunmu_game_store

# ============================================
# Redis配置 (可选 - 用于缓存和监控)
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# 服务配置
# ============================================

NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-domain.com

# ============================================
# 支付配置
# ============================================

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 微信支付
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=

# ============================================
# 监控告警配置
# ============================================

# Prometheus指标
METRICS_ENABLED=true
METRICS_PORT=9090

# 告警Webhook
ALERT_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENTS=

# ============================================
# 安全配置
# ============================================

# CORS允许的域名
CORS_ORIGINS=https://your-domain.com

# 速率限制
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
