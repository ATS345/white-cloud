# ==============================================================================
# 云幕游戏商店平台 - 环境变量配置示例 (前端/根目录)
# 复制此文件为 .env 并填入实际值
# 生产环境必须修改所有密钥配置！
# ==============================================================================

# 应用配置
APP_PORT=80
NODE_ENV=production

# 数据库配置
DB_USER=yunmu
DB_PASSWORD=
DB_NAME=yunmu_game_store
DB_PORT=5432

# Redis配置
REDIS_PASSWORD=
REDIS_PORT=6379

# Elasticsearch配置
ES_PORT=9200

# ==============================================================================
# 🔐 安全配置 - 生产环境必须配置！
# ==============================================================================

# JWT配置 - 必须使用强随机密钥，至少32个字符
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=qq1232580
JWT_REFRESH_SECRET=qq1232580
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# 支付回调验证密钥 - 必须配置，至少32个字符
PAYMENT_CALLBACK_SECRET=qq1232580

# 支付配置
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=

WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=

# CDN配置
CDN_URL=https://cdn.yunmu.com

# 其他配置
CORS_ORIGINS=https://yunmu.com,https://www.yunmu.com
ADMIN_SIMULATION_KEY=
