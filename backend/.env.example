# ==============================================================================
# 云幕游戏商店平台 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# 生产环境必须修改所有密钥配置！
# ==============================================================================

# 数据库配置
DATABASE_URL="postgresql://postgres:password@localhost:5432/cloudcurtain?schema=public"

# Redis配置 (可选)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch配置 (可选)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ==============================================================================
# 🔐 安全配置 - 生产环境必须配置！
# ==============================================================================

# JWT配置 - 必须使用强随机密钥，至少32个字符
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# JWT刷新令牌密钥 - 与JWT_SECRET不同
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# 支付回调验证密钥 - 必须配置，至少32个字符
PAYMENT_CALLBACK_SECRET=

# 应用配置
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 支付配置
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=

# CDN配置
CDN_URL=https://cdn.cloudcurtain.com
CDN_ACCESS_KEY=
CDN_SECRET_KEY=

# 日志配置
LOG_LEVEL=debug
LOG_DIR=./logs

# 管理员模拟支付密钥 (仅开发环境使用)
ADMIN_SIMULATION_KEY=